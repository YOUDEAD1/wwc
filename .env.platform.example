# LEGACY WWC controller only (npm run start:platform).
# New deployments use the separate STORE-MANAGER project and its own .env.example.
# Never run this controller alongside STORE-MANAGER against the same registry.
# The ordinary WWC store uses .env.example and npm start instead.
NODE_ENV=production
PORT=3000
LOG_LEVEL=warn
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
PUBLIC_BASE_URL=""
NSS_API_ORIGIN=""
NSS_BOT_USERNAME=""
# LEGACY embedded manager only. Leave token empty when using independent STORE-MANAGER.
# Public username (no @) may point to the external manager.
WWC_MANAGER_TOKEN=""
WWC_MANAGER_USERNAME=""
WWC_PLATFORM_OWNERS=""
WWC_PLATFORM_SECRET=""
WWC_ENCRYPTION_KEY=""

# Twenty enabled stores share a bounded worker pool; this does not start 20 processes.
WWC_MAX_ACTIVE_SHOPS=20
WWC_MAX_OWNER_SHOPS=1
WWC_MAX_WARM_WORKERS=1
WWC_WORKER_HEAP_MB=128
WWC_WORKER_IDLE_SECONDS=180
WWC_WORKER_QUEUE_LIMIT=32
WWC_WORKER_QUEUE_WAIT_SECONDS=15
WWC_INACTIVITY_HOURS=72

# Set the real NSS wallet price explicitly. Empty disables new wallet checkouts.
WWC_SUBSCRIPTION_USD=""
WWC_SUBSCRIPTION_DAYS=30
# Legacy Stars receipts remain supported.
WWC_SUBSCRIPTION_STARS=500
