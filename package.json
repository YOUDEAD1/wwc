{
  "name": "safwantiger-shop-bot",
  "version": "1.0.0",
  "description": "Futuristic Telegram Shop Bot for @safwantigershopbot — config-driven, Supabase-backed, multi-language.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.mjs",
    "start:platform": "node dist/src/platform/server.js",
    "dev:platform": "tsx src/platform/server.ts",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.0.0",
    "@grammyjs/i18n": "^1.1.0",
    "@grammyjs/menu": "^1.3.0",
    "@grammyjs/parse-mode": "^1.11.1",
    "@supabase/supabase-js": "^2.105.1",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "nodemailer": "^10.2.0",
    "pdfkit": "^0.18.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "resend": "^6.34.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.2",
    "undici": "^6.29.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
