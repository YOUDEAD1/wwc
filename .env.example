# =====================================================================
# SafwanTiger Shop Bot — Environment Variables
# Copy this file to ".env" and fill in real values. Never commit .env.
# =====================================================================

# --- Telegram ---
# Get from @BotFather after /newbot.
# Either name works; TELEGRAM_BOT_TOKEN is preferred. BOT_TOKEN is accepted as a legacy alias.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN
# BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Telegram numeric user ID of the primary admin (used to seed the admin table)
ADMIN_USER_ID=7913962419

# Optional: numeric chat id of a private channel/supergroup that
# receives all "deep details" log notifications (orders, top-ups,
# support sessions, transcripts, PDF sends, language/notification
# toggles, etc.). Falls back to ADMIN_USER_ID DM when unset. The bot
# must be added as an admin in that chat with permission to post
# messages.
#
# How to get the id: forward any message from the channel to
# @userinfobot or @RawDataBot. Channel ids start with -100… (e.g.
# -1002145678901).
LOG_CHAT_ID=

# Bot username (without @) — used for referral links
BOT_USERNAME=safwantigershopbot

# --- Supabase ---
# From: Supabase project → Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# IMPORTANT: Use the *service_role* key on the server (never expose it client-side).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...REPLACE_ME

# Optional: anon (public) key — only needed if you build a separate client-side
# admin dashboard against Supabase Auth. The bot itself does NOT use this.
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# --- Bot runtime ---
# "polling" (default, recommended on Railway) or "webhook"
BOT_MODE=polling

# Only used when BOT_MODE=webhook
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=3000

# Default language for new users (en | ar | vi)
DEFAULT_LANG=en

# Log level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# --- Optional: Automated Support Assistant ---
# Leave empty to use the built-in stub responder.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional: Binance Pay (auto-approval of deposits) ---
# Get these from https://merchant.binance.com → API Management.
# When BOTH are set, the admin can add a "Binance Pay" payment method
# from /admin → 💳 Payments → 💎 Add Binance Pay, and users get an
# instant checkout link instead of manual instructions.
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=

# Public HTTPS URL of this bot service (Railway domain) used as the
# Binance returnUrl + webhookUrl. No trailing slash.
PUBLIC_BASE_URL=
