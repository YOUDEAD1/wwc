# =====================================================================
# SafwanTiger Shop Bot — متغيرات البيئة
# انسخ هذا الملف إلى ".env" وأضف القيم الحقيقية. لا ترفعه على GitHub أبداً.
# =====================================================================

# --- تيليجرام ---
# احصل عليه من @BotFather بعد /newbot
# كلا الاسمين يعملان؛ TELEGRAM_BOT_TOKEN هو الأفضل. BOT_TOKEN يُقبل كبديل قديم.
TELEGRAM_BOT_TOKEN=

# معرف تيليجرام الرقمي للمشرف الرئيسي (يُستخدم لإضافته في جدول الأدمن)
ADMIN_USER_ID=

# اختياري: القناة التي تستقبل جميع إشعارات السجل التفصيلية
# (الإيداعات، جلسات الدعم، اللغة، الإشعارات، رموز الهدايا، تغييرات الرصيد، إلخ)
# إذا تُركت فارغة، تُرسل الإشعارات إلى DM المشرف مباشرةً
# الصيغ المقبولة:
#   @channelusername  لقناة عامة
#   -100<رقم_القناة>  لقناة خاصة أو مجموعة (أرسل أي رسالة لـ @userinfobot لمعرفة الرقم)
#   0 أو off أو none  لتعطيل هذه الميزة
LOG_CHAT_ID=

# اختياري: قناة مخصصة لإشعارات الطلبات فقط
# نفس صيغة LOG_CHAT_ID. إذا تُركت فارغة تُرسل للقناة الرئيسية ثم DM المشرف
ORDER_LOG_CHAT_ID=

# اسم البوت بدون @ — يُستخدم لروابط الإحالة
BOT_USERNAME=

# --- Supabase ---
# من: مشروع Supabase ← Settings ← API
SUPABASE_URL=

# مهم: استخدم مفتاح service_role على السيرفر (لا تعرضه على الواجهة الأمامية أبداً)
SUPABASE_SERVICE_ROLE_KEY=

# --- إعدادات تشغيل البوت ---
# "polling" (الافتراضي، موصى به) أو "webhook"
BOT_MODE=polling

# يُستخدم فقط عند BOT_MODE=webhook
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=3000

# اللغة الافتراضية للمستخدمين الجدد (en | ar | vi)
DEFAULT_LANG=en

# مستوى السجلات (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# --- اختياري: مساعد الدعم الآلي ---
# يمكن إضافة المفتاح من داخل البوت عبر: 🤖 إعداد الذكاء الاصطناعي ← 🔑 تعيين مفتاح API
# الكشف عن المزود يتم تلقائياً حسب شكل المفتاح:
#   AIza…  ← Google AI Studio (Gemini)  — النموذج الافتراضي: gemini-2.5-flash
#   sk-…   ← OpenAI                      — النموذج الافتراضي: gpt-4o-mini
# اتركهما فارغين لاستخدام الردود الافتراضية المدمجة
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# =====================================================================
# التحقق التلقائي من المدفوعات
# =====================================================================
# جميع المزودين أدناه اختياريون. البوت يعمل بدونهم —
# التحقق سيتحول إلى موافقة يدوية من الأدمن عند غياب أي مفتاح

# --- TonCenter (التحقق من USDT على شبكة TON)
# الطبقة المجانية تعمل بدون مفتاح (طلب/ثانية)، المفتاح يرفع الحد
TONCENTER_API_KEY=

# --- TronGrid (التحقق من USDT TRC20)
# الطبقة المجانية تعمل لكن تفرض قيوداً صارمة تحت الضغط
TRONGRID_API_KEY=

# --- BlockCypher (التحقق من LTC)
# الطبقة المجانية (~3 طلبات/ثانية) كافية للبوتات ذات الحجم المنخفض
BLOCKCYPHER_TOKEN=

# --- CoinGecko (سعر LTC/USD)
# تعمل بدون مفتاح لكن محدودة. المفتاح ضروري في الإنتاج
COINGECKO_API_KEY=

# --- Binance Pay (التحقق التلقائي عبر Binance Spot API)
# أنشئ المفتاح من: binance.com ← My Account ← API Management
# فعّل صلاحية "Reading" فقط — لا تفعّل التداول أو السحب أبداً
# إذا تُركا فارغين، كل طلبات Binance Pay تذهب للمراجعة اليدوية
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=